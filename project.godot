; Engine configuration file.
; Edit through Godot when practical so generated settings remain valid.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Drought Prototype"
config/description="M0 foundation for the causal village simulation prototype."
run/main_scene="res://ui/main.tscn"

[debug]

gdscript/warnings/inferred_declaration=2
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
